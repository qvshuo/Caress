{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@playwright/test": [
        "./node_modules/@playwright/test"
      ]
    }
  },
  "include": [
    "src",
    "dev.ts",
    "build.ts",
    "../../tests/web",
    "playwright.config.ts"
  ]
}
